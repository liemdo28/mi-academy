{"gameId":"math_supermarket","schemaVersion":"1.0.0","description":"Kids shop for items, calculate totals, and make change. Teaches money, budgeting, and arithmetic.","levels":[{"id":"ms-lv01","gameId":"math_supermarket","levelNumber":1,"difficulty":1,"learningObjective":"Nhận biết tiền — đếm đồng xu","localizedContent":{"vi":{"prompt":"Con có 3 đồng xu. Mua quả cam giá 2 đồng. Còn lại bao nhiêu?","options":[{"id":"a","text":"1 đồng","correct":true},{"id":"b","text":"2 đồng","correct":false},{"id":"c","text":"3 đồng","correct":false}]},"en":{"prompt":"You have 3 coins. An orange costs 2 coins. How much is left?","options":[{"id":"a","text":"1 coin","correct":true},{"id":"b","text":"2 coins","correct":false},{"id":"c","text":"3 coins","correct":false}]}},"hints":[{"text":"3 trừ đi 2 bằng mấy?"},{"text":"3 - 2 = 1"}],"metadata":{"ageGroup":"junior","skillIds":["math.currency.basic","math.subtraction.within_10"],"budget":3,"currencyUnit":"đồng"},"assetRefs":["mi-fruit-orange","mi-coin-1"],"contentVersion":1,"estimatedSeconds":60,"publicationState":"published"},{"id":"ms-lv02","gameId":"math_supermarket","levelNumber":2,"difficulty":1,"learningObjective":"Tính tổng giá 2 mặt hàng đơn giản","localizedContent":{"vi":{"prompt":"Quả táo 2 đồng, quả chuối 3 đồng. Tổng cộng bao nhiêu?","options":[{"id":"a","text":"4 đồng","correct":false},{"id":"b","text":"5 đồng","correct":true},{"id":"c","text":"6 đồng","correct":false}]},"en":{"prompt":"Apple costs 2 coins. Banana costs 3 coins. How much together?","options":[{"id":"a","text":"4 coins","correct":false},{"id":"b","text":"5 coins","correct":true},{"id":"c","text":"6 coins","correct":false}]}},"hints":[{"text":"Cộng giá hai mặt hàng"},{"text":"2 + 3 = 5"}],"metadata":{"ageGroup":"junior","skillIds":["math.currency.basic","math.addition.within_10"],"budget":10,"currencyUnit":"đồng"},"assetRefs":["mi-fruit-apple","mi-fruit-banana"],"contentVersion":1,"estimatedSeconds":60,"publicationState":"published"},{"id":"ms-lv03","gameId"