# Copy this file to key.properties (same directory) and fill in real values.
# key.properties is gitignored -- never commit the real file or the keystore
# it points at. See docs/android-signing.md for how to generate the
# keystore and what these fields mean.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/or/relative/path/to/upload-keystore.jks
