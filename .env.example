# MI Academy — Environment Variables (copy to .env, fill real values)

# App
APP_ENV=development
DEBUG=true

# Database (use sqlite for zero-config dev, or postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./mi_academy.db
CREATE_TABLES_ON_STARTUP=true

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_64_CHARS_RANDOM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Security
BCRYPT_ROUNDS=12

# Sync
SYNC_RATE_LIMIT_PER_MIN=60
AUTH_RATE_LIMIT_PER_MIN=10

# Redis (optional, for cache)
REDIS_URL=redis://localhost:6379
